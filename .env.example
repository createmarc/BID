# Ticketmaster Discovery API (free, required for best results)
# Register at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# SerpApi for Google Events (optional but recommended)
# Free trial: https://serpapi.com/ — 100 free searches
SERPAPI_KEY=

# Instagram via Apify (no Facebook/Instagram account needed)
# Sign up free at https://apify.com — $5/month compute credits included
# Get your token at: https://console.apify.com/account/integrations
# Cost per weekly run: ~$0.05–0.10 (well within free tier)
APIFY_API_TOKEN=apify_api_kt35dlhBF85JQBwzl9ZAWxYOQi4GqL3G8Dc8

# Secret token to protect the /api/refresh endpoint
REFRESH_SECRET=change-me-to-a-random-string

# SQLite database file path
DATABASE_PATH=./data/events.db
