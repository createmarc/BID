# Ticketmaster Discovery API (free, required for best results)
# Register at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# SerpApi for Google Events (optional but recommended)
# Free trial: https://serpapi.com/ — 100 free searches
SERPAPI_KEY=

# Instagram Graph API (optional — finds events posted on Instagram)
# Setup: https://developers.facebook.com/docs/instagram-platform/instagram-graph-api
# Requires a Meta Developer app + Instagram Business/Creator account
# Generate a long-lived access token (valid 60 days, must be refreshed monthly)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Secret token to protect the /api/refresh endpoint
REFRESH_SECRET=change-me-to-a-random-string

# SQLite database file path
DATABASE_PATH=./data/events.db
