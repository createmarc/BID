# Ticketmaster Discovery API (free, required for best results)
# Register at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# SerpApi for Google Events (optional but recommended)
# Free trial: https://serpapi.com/ — 100 free searches
SERPAPI_KEY=

# Secret token to protect the /api/refresh endpoint
REFRESH_SECRET=change-me-to-a-random-string

# SQLite database file path
DATABASE_PATH=./data/events.db
